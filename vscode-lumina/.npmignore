# Exclude all .vsix files from npm package
# These are large binary files that should only be distributed via GitHub releases
*.vsix

# Desktop app installers (also distributed via GitHub releases)
# IMPORTANT: All platform binaries must be excluded - distributed via GitHub releases only
*.exe
*.msi
*.dmg
*.deb
*.AppImage
*.zip

# VS Code test artifacts
# CRITICAL: .vscode-test-user-data/ contains 50MB+ cache files - MUST exclude
.vscode-test/
.vscode-test-user-data/

# Development files
.vscode/
.claude/
src/
*.ts
!*.d.ts
tsconfig.json
*.map

# Test files
test/
tests/
**/*.test.js
**/*.test.ts

# Git files
.git/
.gitignore

# Editor files
.DS_Store
Thumbs.db

# Log files
*.log
